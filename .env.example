# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Bot token, used to log in to Discord. Discord Developer Portal → your application → Bot → Reset Token.
DISCORD_TOKEN=

# Application (client) ID, used to register slash commands. Developer Portal → your application → General Information.
DISCORD_CLIENT_ID=

# ID of the one server this bot serves; commands are registered there only. Enable Developer Mode in Discord, then right-click the server → Copy Server ID.
DISCORD_GUILD_ID=

# Where the SQLite database file lives. /data is the Docker volume in compose.yaml, so leave this as is unless you run without Docker.
DB_PATH=/data/porto.db

# IANA time zone that decides what "today" means for trade dates (future dates are rejected). Optional, defaults to America/New_York. List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York
